         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">N34C04 - EEPROM Serial 4-Kb SPD for DDR4 DIMM</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The N34C04 is a EEPROM Serial 4âˆ’Kb, which implements the&#xD;&#xA;JEDEC JC42.4 (EE1004âˆ’v) Serial Presence Detect (SPD)&#xD;&#xA;specification for DDR4 DIMMs and supports the Standard (100 kHz),&#xD;&#xA;Fast (400 kHz) and Fast Plus (1 MHz) I2C protocols.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:45e4f094-8fd5-4a61-adb9-e92efa6e6989</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:877f4d88-eff8-451c-964d-37730b6bb0cf</xmpMM:InstanceID>
      </rdf:Description>
